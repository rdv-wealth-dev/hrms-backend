		{
			"name": "01. Auth Module",
			"item": [
				{
					"name": "1. Register Organization & Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.succeeded && res.data) {",
									"    if (res.data.accessToken) pm.environment.set('accessToken', res.data.accessToken);",
									"    if (res.data.refreshToken) pm.environment.set('refreshToken', res.data.refreshToken);",
									"    if (res.data.tenantId) pm.environment.set('tenantId', res.data.tenantId);",
									"    if (res.data.user && res.data.user.id) pm.environment.set('userId', res.data.user.id);",
									"    console.log('Saved auth tokens and tenant ID');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"companyName\": \"Shikhar Technologies Private Limited\",\n  \"workspaceSlug\": \"shikhar-tech\",\n  \"adminFirstName\": \"Shikhar\",\n  \"adminLastName\": \"Sharwalia\",\n  \"email\": \"admin.shikhar@mailinator.com\",\n  \"password\": \"Admin@12345!\",\n  \"phone\": \"9876543210\",\n  \"countryCode\": \"IN\",\n  \"currency\": \"INR\",\n  \"employeeCountRange\": \"1-50\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						}
					}
				},
				{
